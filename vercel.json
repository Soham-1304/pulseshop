{
  "version": 2,
  "installCommand": "npm install --ignore-scripts",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "services/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__path=/api/$1"
    },
    {
      "source": "/metrics",
      "destination": "/api/index.js?__path=/metrics"
    },
    {
      "source": "/health",
      "destination": "/api/index.js?__path=/health"
    }
  ]
}
