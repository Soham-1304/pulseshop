# Database & Cache
MONGODB_URI=mongodb://localhost:27017/pulseshop
REDIS_URL=redis://localhost:6379

# Microservice Internal URLs
GATEWAY_PORT=4000
ORDERS_PORT=4001
PAYMENTS_PORT=4002
ORDERS_SERVICE_URL=http://localhost:4001
PAYMENTS_SERVICE_URL=http://localhost:4002

# Release & Telemetry Metadata (Populated by GitHub Actions / Docker build)
SERVICE_VERSION=v1
GIT_COMMIT_SHA=main-initial
NODE_ENV=development

# SRE Agent Webhook Listener (Used by CI/CD deploy step)
SRE_AGENT_LISTENER_URL=http://localhost:5050
